DS_BASE_URL=https://api.deepseek.com
DS_API_KEY=
DS_MODEL=deepseek-flash
DS_THINKING=enabled
DS_REASONING_EFFORT=low

# 仓库平台接入：读取 Issue、以及发布审批后的草稿合并请求。
# 平台由 Issue 链接或仓库 remote 自动判断，不需要另外声明。
# GitHub：GH_TOKEN 也接受。
GITHUB_TOKEN=
# 可选GitHub App安装身份：GITHUB_AUTH=app时不会回退到个人令牌。
# GITHUB_AUTH=app
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=.local/secrets/repopilot-github-app.pem
# GitLab（gitlab.com 或自建实例）：GL_TOKEN 也接受；个人令牌至少需要 api 与 read_repository。
GITLAB_TOKEN=

# 登记一位负责人，用于从父Issue评论采纳业务答复（不是批准）。
# 只有该登录名的评论会成为答复；机器人、自身标记评论和引用文本会被忽略。
# REPOPILOT_OWNER=your-github-or-gitlab-login

# Optional: cumulative estimate cap for the local runtime ledger (CNY).
REPOPILOT_BUDGET_CNY=200

# 仓库事实记忆默认关闭，也可在新运行时使用--memory显式开启。
REPOPILOT_MEMORY_ENABLED=false

# 新任务默认先整理任务说明与顺序计划；设为false等同--no-plan。
REPOPILOT_PLAN_ENABLED=true
# Issue任务等待澄清时自动发父Issue评论并轮询登记负责人回复；设为false只等本地CLI答复。
REPOPILOT_ISSUE_COMMENTS_ENABLED=true
# 并行实现槽位：所有运行共享，初始最多2；等待空位的超时秒数。
REPOPILOT_MAX_IMPLEMENTATION_SLOTS=2
REPOPILOT_SLOT_TIMEOUT_SECONDS=30

# Optional provider selection: deepseek (default), qwen, openai-compatible, anthropic.
# Existing DS_* configuration continues to work without these variables.
# Non-DeepSeek requires all five values below; prices are YOUR conservative CNY estimates,
# per million input/output tokens, not vendor quotes. See docs/runtime-v2/MODELS.md.
# REPOPILOT_PROVIDER=qwen
# REPOPILOT_API_KEY=
# REPOPILOT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# REPOPILOT_MODEL=YOUR_TOOL_CAPABLE_MODEL_ID
# REPOPILOT_INPUT_CNY_PER_MILLION=
# REPOPILOT_OUTPUT_CNY_PER_MILLION=

# Legacy diagnostic scripts only; the new runtime does not require these.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
